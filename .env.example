# Copy this file to .env.local for local development, then fill in real values.
# NEVER commit .env.local. In production, add these in Vercel → Project → Settings → Environment Variables.

# Public site URL (used for Stripe redirect links). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://kingbomb.food

# ── Mailchimp (email signup) ─────────────────────────────
# API key: Mailchimp → Profile → Extras → API keys
MAILCHIMP_API_KEY=
# Audience ID: Audience → Settings → Audience name and defaults
MAILCHIMP_LIST_ID=
# The part after the dash in your API key, e.g. us21
MAILCHIMP_SERVER_PREFIX=

# ── Stripe (checkout) ────────────────────────────────────
# Use sk_test_ / pk_test_ keys while testing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From Stripe → Developers → Webhooks (or `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=

# ── Resend (order emails) ────────────────────────────────
RESEND_API_KEY=
# Where new-order notifications go (your inbox)
ORDER_NOTIFICATION_EMAIL=
# Optional: where Contact page messages go (defaults to ORDER_NOTIFICATION_EMAIL)
CONTACT_EMAIL=
# Optional: sender address. Must be on a domain verified in Resend.
ORDER_FROM_EMAIL="KINGBOMB <orders@kingbomb.food>"
